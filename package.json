    "test:concurrency": "vitest run tests/concurrency.test.ts tests/integration/concurrency.test.ts tests/integration/spaces-concurrency.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "spaces:ops": "tsx scripts/open-space.ts ops",
    "spaces:connector": "tsx scripts/open-space.ts connector",
    "spaces:official": "tsx scripts/open-space.ts official",
    "spaces:campus": "tsx scripts/campus-spaces.ts"
