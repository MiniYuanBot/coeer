    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "redaxios": "^0.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "srvx": "0.11.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
