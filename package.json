    "build": "vite build",
    "analyze": "node scripts/analyze-build.mjs",
    "test:performance": "tsx tests/performance-smoke.ts",
    "preview": "vite preview",
    "start": "srvx --prod --host 127.0.0.1 -s ../client dist/server/server.js",
