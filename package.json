{
  "name": "coeer",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "srvx --prod --host 127.0.0.1 -s ../client dist/server/server.js",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check",
    "deploy:rollback": "node scripts/deploy.mjs --rollback",
    "test:deploy": "node --test scripts/deploy.test.mjs && python3 -m unittest discover -s deploy -p 'test_*.py'",
    "seed:users": "tsx src/server/database/seed/users.seed.ts",
    "seed:users:clean": "tsx src/server/database/seed/users.seed.ts --clean",
    "seed:community": "tsx src/server/database/seed/community.seed.ts",
    "seed:community:clean": "tsx src/server/database/seed/community.seed.ts --clean",
    "seed:feedbacks": "tsx src/server/database/seed/feedback.seed.ts",
    "seed:feedbacks:clean": "tsx src/server/database/seed/feedback.seed.ts --clean",
    "seed:gamification": "tsx src/server/database/seed/gamification.seed.ts",
    "seed:gamification:clean": "tsx src/server/database/seed/gamification.seed.ts --clean",
    "seed:all": "tsx src/server/database/seed/index.ts",
    "seed:all:clean": "tsx src/server/database/seed/index.ts --clean",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check:env": "tsx src/server/config/env.ts",
    "test": "vitest run && node --test scripts/deploy.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "spaces:ops": "tsx scripts/open-space.ts ops",
    "spaces:connector": "tsx scripts/open-space.ts connector",
    "spaces:official": "tsx scripts/open-space.ts official"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.161.3",
    "@tanstack/react-router-devtools": "^1.161.3",
    "@tanstack/react-start": "^1.161.3",
    "@tanstack/react-start-router-manifest": "^1.120.19",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redaxios": "^0.5.1",
    "srvx": "0.11.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "linkedom": "^0.18.12",
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@electric-sql/pglite": "^0.3.15",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.0.0 <12",
    "pnpm": ">=10.33.4 <11"
  }
}
