# Runtime
# NODE_ENV will be set automatically
PORT=3000
CLIENT_URL=http://localhost:3000

# PostgreSQL
# Local example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/coeer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DB_POOL_MIN=1
DB_POOL_MAX=10

# Secrets
# Generate production values with:
# openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-characters

# Public client env
VITE_APP_NAME=COEER
VITE_API_URL=

# Space reservations (project runtime: Node.js 26.x, npm 11.x, pnpm 10.33.4)
# Reservations reuse DATABASE_URL above; tables use a separate PostgreSQL schema.
# Schema/table initialization requires CREATE privileges. No SQLite fallback/import.
OPENSPACE_DATABASE_SCHEMA=coeer_spaces
# Development and production use the official adapter. Mock requires an explicit test setting.
OPENSPACE_ADAPTER_MODE=official
# Maximum advance booking days; background sync covers the same entire range.
# Includes today and day 7. Change and restart to adjust both together.
OPENSPACE_BOOKING_DAYS=7
# Official JSON uses rulesSource: "upstream" in both environments.
# See config/official.upstream.example.json and config/official.meeting-contract.example.json.
# The latter describes form fields; its empty rules array adds no local date/duration limit.
# Public signup requires a 10-digit student email: xxxxxxxxxx@stu.pku.edu.cn.
# Only connect to a backend supporting COEER signed identity, not a legacy login API:
# OPENSPACE_BACKEND_URL=http://127.0.0.1:3001
# Required for a remote backend; both servers must use the same private random key.
# Embedded mode automatically generates an in-process key.
# OPENSPACE_INTERNAL_AUTH_SECRET=replace-with-a-private-random-key
# Its configured allowed origin (required if different from CLIENT_URL):
# OPENSPACE_APP_ORIGIN=https://openspace.example.com
# Put shared official paths/settings in ignored .env.local; keep DATABASE_URL in .env.
# APP_ENV defaults: staging for development; production for NODE_ENV=production.
# Origin/cookie/connector security differs; official booking rules stay the same.
# Keep official configuration, encrypted credentials, and session keys outside Git.
# pnpm spaces:campus login / pnpm spaces:campus probe use this private directory:
# OPENSPACE_CAMPUS_PRIVATE_DIR=../.coeer-local
# Direct local configuration (no VPN/proxy):
# OPENSPACE_APP_ORIGIN=http://localhost:3000
# OPENSPACE_OFFICIAL_CONFIG_FILE=../.coeer-local/official.json
# OPENSPACE_OFFICIAL_WRITES_FILE=../.coeer-local/writes.json
# OPENSPACE_OFFICIAL_SESSION_FILE=../.coeer-local/session.enc.json
# OPENSPACE_OFFICIAL_SESSION_KEY_FILE=../.coeer-local/session-key.json
# OPENSPACE_OFFICIAL_AUTH_MODE=operator_sso
# OPENSPACE_OFFICIAL_HTTP_NETWORK_APPROVED=true
# Enable with the private form protocol. Base JSON may keep writes.enabled=false
# when OFFICIAL_WRITES_FILE supplies the contact and contract field mappings.
OPENSPACE_OFFICIAL_WRITES_ENABLED=true
# Optional explicit approval for automatic recovery through the normal official login page:
# OPENSPACE_OFFICIAL_AUTOMATIC_LOGIN_APPROVED=true
# OPENSPACE_OFFICIAL_ACCOUNT_CREDENTIALS_FILE=../.coeer-local/account.enc.json
# OPENSPACE_OFFICIAL_ACCOUNT_KEY_FILE=../.coeer-local/account-key.json
# OPENSPACE_OFFICIAL_RECOVERY_STATE_FILE=../.coeer-local/recovery-state.json
# Renew only a valid lease after independently verifying the pinned official identity:
# OPENSPACE_OFFICIAL_SESSION_RENEWAL=true
# Production requires an isolated Connector using the same rulesSource/upstream protocol:
# OPENSPACE_APP_ENV=production
# OPENSPACE_APP_ORIGIN=https://coeer.example.com
# OPENSPACE_OFFICIAL_CONNECTOR_URL=http://127.0.0.1:3002
# OPENSPACE_OFFICIAL_CONNECTOR_KEY_FILE=/private/connector-key.json
# Server runtime and spaces commands load process env first, then:
# .env.<NODE_ENV>.local, .env.local, .env.<NODE_ENV>, .env.
# Tests use DATABASE_URL with random coeer_test_* schemas and clean only those schemas.
