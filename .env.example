# Runtime
# NODE_ENV will be set automatically
PORT=3000
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Password recovery email (set all required values to enable; use HTTPS APP_URL in production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=coeer@example.com
# SMTP_PASSWORD=replace-with-mail-service-password
# SMTP_FROM=COEER <coeer@example.com>

# PostgreSQL
# Local example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/coeer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DB_POOL_MIN=1
DB_POOL_MAX=10

# Secrets
# Generate production values with:
# openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-characters

# Public client env
VITE_APP_NAME=COEER
VITE_API_URL=

# 空间预约：BOOKING_* 管预约业务；CAMPUS_* 管官网账号与接口；CONNECTOR_* 管独立连接器。
# 数据库复用上面的 DATABASE_URL；以下 schema 会在预约后台启动时自动创建。
BOOKING_DB_SCHEMA=coeer_spaces

# 数据来源：official=真实官网，mock=模拟测试，official-disabled=关闭官方接入。
BOOKING_DATA_SOURCE=official
# 最多提前预约的天数；7 表示今天至今天加 7 天，共 8 个日期，同时控制后台同步范围。
BOOKING_ADVANCE_DAYS=7
# 运行环境：开发默认 staging，NODE_ENV=production 时默认 production；staging 仍可真实预约。
# BOOKING_RUNTIME_ENV=staging
# 预约 API 认可的请求来源；默认跟随 CLIENT_URL。生产环境必须使用 HTTPS。
# BOOKING_ALLOWED_ORIGIN=http://localhost:3000
# 后台同步与用户提交开关；不设置时沿用数据库中的管理配置。
# BOOKING_SYNC_ENABLED=true
# BOOKING_SUBMISSIONS_ENABLED=true

# 本机校园网直连：将以下私密路径放入已被 Git 忽略的 .env.local。
# 此目录供 pnpm spaces:campus login/probe 使用，默认 ./.coeer-local。
# 下面各文件变量可单独指定路径；显式路径同时供应用和校园网命令使用。
# BOOKING_PRIVATE_DIR=./.coeer-local
# 官网接口、服务账号身份与规则来源配置；正常使用 rulesSource: "upstream"。
# CAMPUS_API_CONFIG_FILE=./.coeer-local/official.json
# 可选：独立的预约表单协议与联系方式。主配置内已有完整协议时省略。
# CAMPUS_BOOKING_FORM_FILE=./.coeer-local/writes.json

# 官网账号密码：加密文件 + 解密密钥。这里不是 COEER 用户的登录密码。
# CAMPUS_ACCOUNT_FILE=./.coeer-local/account.enc.json
# CAMPUS_ACCOUNT_KEY_FILE=./.coeer-local/account-key.json
# 官网登录成功后保存的 Cookie 会话：加密文件 + 解密密钥。
# CAMPUS_COOKIE_FILE=./.coeer-local/session.enc.json
# CAMPUS_COOKIE_KEY_FILE=./.coeer-local/session-key.json
# 登录方式：默认 operator_sso，使用正常网页登录获得的 Cookie。
# CAMPUS_LOGIN_METHOD=operator_sso
# 当前校园官网接口使用 HTTP，直连时需要显式允许；此开关不会建立 VPN 或代理。
# CAMPUS_ALLOW_HTTP=true
# 允许向官网创建/取消预约；还需要有效的官网表单协议。false 不影响只读查询。
CAMPUS_WRITE_ENABLED=true

# 可选：会话失效后读取上面的加密账号密码，自动执行一次正常网页登录。
# 默认关闭；启用时还需配置账号文件、账号密钥、Cookie 文件、Cookie 密钥及下面的状态文件。
# CAMPUS_AUTO_RELOGIN=true
# 保存重登次数、冷却时间和人工验证状态，避免重启后无限重试。
# CAMPUS_RELOGIN_STATE_FILE=./.coeer-local/recovery-state.json
# 核对官网身份成功后续期尚未过期的本地会话租约；不会延长官网 Cookie 的有效期。
# CAMPUS_COOKIE_LEASE_RENEWAL=true
# 可选：正常网页登录使用的 Chromium/Chrome 可执行文件路径。
# CAMPUS_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe

# 生产部署：预约引擎通过独立 Connector 访问官网；本机校园网直连时无需设置 URL。
# BOOKING_RUNTIME_ENV=production
# BOOKING_ALLOWED_ORIGIN=https://coeer.example.com
# CONNECTOR_URL=http://127.0.0.1:3002
# 引擎与 Connector 共用的通信令牌文件；与账号密钥、Cookie 密钥用途不同。
# CONNECTOR_TOKEN_FILE=/private/connector-key.json
# 以下是 Connector 进程自己的监听地址与端口。
# CONNECTOR_LISTEN_HOST=127.0.0.1
# CONNECTOR_LISTEN_PORT=3002

# 可选：将“完整预约引擎”单独部署。它包含数据库/权限/任务，Connector 只负责官网访问。
# 默认内嵌在 COEER 中；配置此 URL 后，主站改为转发到外置预约引擎。
# BOOKING_ENGINE_URL=http://127.0.0.1:3001
# COEER 与外置预约引擎共用的身份签名密钥；内嵌模式自动生成，无需填写。
# BOOKING_ENGINE_SIGNING_SECRET=replace-with-a-private-random-key

# 主站与命令的配置优先级：进程环境 > .env.<NODE_ENV>.local > .env.local > .env.<NODE_ENV> > .env。
# 修改配置后重启服务。账号、密码、Cookie 和密钥文件均保留在 .coeer-local 中，不加入 Git。
# 测试使用 DATABASE_URL 和随机 coeer_test_* schema，只清理测试自己的数据。
